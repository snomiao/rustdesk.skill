#!/usr/bin/env bash
# pre-commit secret / personal-data scanner for this PUBLIC repo.
# Blocks the commit if staged changes look like they contain company / personal /
# local-only data. Bypass intentionally with `git commit --no-verify`.
#
# Install: bash scripts/install-hooks.sh  (sets core.hooksPath = .githooks)
# Add your own private patterns (one per line, ERE) in `.secret-denylist` (gitignored).

set -uo pipefail   # NOT -e: scanner greps return non-zero on no-match by design.

# Only scan lines being ADDED (not context/removed). -U0 = no context.
# Exclude the meta files that legitimately contain these patterns: the hook
# itself (the detector regexes) and CLAUDE.md (the "do not commit these" doc).
added="$(git diff --cached --no-color -U0 --diff-filter=ACM -- . ':!.githooks/' ':!CLAUDE.md' 2>/dev/null \
  | grep -E '^\+' | grep -Ev '^\+\+\+' | sed -E 's/^\+//' || true)"

[ -z "$added" ] && exit 0

# Built-in, public-safe patterns. label<TAB>regex
patterns=$'email\t[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}
tailscale-ip\t\\b100\\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\\.[0-9]{1,3}\\.[0-9]{1,3}\\b
private-key\t-----BEGIN [A-Z ]*PRIVATE KEY-----
github-token\tgh[pousr]_[A-Za-z0-9]{20,}
github-pat\tgithub_pat_[A-Za-z0-9_]{20,}
tailscale-key\ttskey-[a-z]+-[A-Za-z0-9]+
slack-token\txox[baprs]-[A-Za-z0-9-]{10,}
aws-key\tAKIA[0-9A-Z]{16}
google-key\tAIza[0-9A-Za-z_-]{30,}
local-path-unix\t(/Users/|/home/[a-z0-9._-]+/|~/ws/)
local-path-win\t[A-Za-z]:\\\\Users\\\\'

# Allow obvious placeholders to avoid false positives.
allow='example\.(com|org|net)|@example|<[a-z-]+>|placeholder|123456789|hunter2|user@host'

found=0
report() { printf '  ✗ %-16s %s\n' "$1" "$2"; found=1; }

scan() { # label, regex
  local label="$1" re="$2" hits
  hits="$(printf '%s\n' "$added" | grep -EnI "$re" 2>/dev/null | grep -Ev "$allow" 2>/dev/null)" || hits=""
  [ -n "$hits" ] && while IFS= read -r line; do report "$label" "$line"; done <<<"$hits"
  return 0
}

while IFS=$'\t' read -r label re; do
  [ -z "$label" ] && continue
  scan "$label" "$re"
done <<<"$patterns"

# Extra private patterns (gitignored, local-only).
if [ -f .secret-denylist ]; then
  while IFS= read -r re; do
    [ -z "$re" ] && continue; case "$re" in \#*) continue;; esac
    scan "denylist" "$re"
  done < .secret-denylist
fi

if [ "$found" -ne 0 ]; then
  echo ""
  echo "⛔ pre-commit: staged changes look like company/personal/local-only data (this repo is PUBLIC)."
  echo "   Replace with placeholders (see CLAUDE.md). If it's a false positive, commit with --no-verify."
  exit 1
fi
exit 0
